{
  "name": "WF-04: 컨펌 요청 발송",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-04-confirm-request",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-wf04",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM jobs WHERE id='{{$json.job_id}}'",
        "options": {}
      },
      "id": "node-pg-get-job",
      "name": "Get Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "postgres": {"id": "pg-credentials", "name": "PostgreSQL"}
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equals",
              "value2": "WAITING_APPROVAL"
            }
          ]
        }
      },
      "id": "node-if-waiting",
      "name": "Is WAITING_APPROVAL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://messenger-gateway:8080/internal/send-confirm",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Internal-Secret", "value": "={{$env.GATEWAY_INTERNAL_SECRET}}"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "job_id", "value": "={{$json.id}}"},
            {"name": "messenger_source", "value": "={{$json.messenger_source}}"},
            {"name": "messenger_user_id", "value": "={{$json.messenger_user_id}}"},
            {"name": "messenger_channel_id", "value": "={{$json.messenger_channel_id}}"},
            {"name": "title", "value": "={{$json.script_json?.title ?? '제목 없음'}}"},
            {"name": "script_summary", "value": "={{$json.script_json?.script_summary ?? '요약 없음'}}"},
            {"name": "preview_url", "value": "={{$json.preview_url ?? ''}}"}
          ]
        },
        "options": {}
      },
      "id": "node-http-send-confirm",
      "name": "Send Confirm → Gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {"name": "error", "value": "Job is not in WAITING_APPROVAL status"}
          ]
        },
        "options": {}
      },
      "id": "node-error-response",
      "name": "Status Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Get Job", "type": "main", "index": 0}]]
    },
    "Get Job": {
      "main": [[{"node": "Is WAITING_APPROVAL?", "type": "main", "index": 0}]]
    },
    "Is WAITING_APPROVAL?": {
      "main": [
        [{"node": "Send Confirm → Gateway", "type": "main", "index": 0}],
        [{"node": "Status Error", "type": "main", "index": 0}]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["phase-1"]
}
